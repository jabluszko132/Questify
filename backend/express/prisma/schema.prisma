generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id              Int                @id @default(autoincrement())
  nickname        String
  email           String             @unique
  avatar          Avatars?
  user_questlists Users_questlists[]
  friends         Friends[]          @relation("is_a_friend")
  friends2        Friends[]          @relation("has_a_friend")
  stats           Stats?
  date_created    DateTime           @default(now())
  date_updated    DateTime           @updatedAt
}

model Passwords {
  user_id      Int      @id
  password     String
  salt         String
  date_created DateTime @default(now())
  date_updated DateTime @updatedAt
}

model Avatars {
  user          Users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       Int          @id
  hat           Hats?        @relation(fields: [hat_id], references: [id], onDelete: SetNull)
  hat_id        Int?
  glass         Glasses?     @relation(fields: [glasses_id], references: [id], onDelete: SetNull)
  glasses_id    Int?
  background    Backgrounds? @relation(fields: [background_id], references: [id], onDelete: SetNull)
  background_id Int?
  frame         Frames?      @relation(fields: [frame_id], references: [id], onDelete: SetNull)
  frame_id      Int?
  date_created  DateTime?    @default(now())
  date_updated  DateTime?    @updatedAt
}

model Hats {
  id           Int       @id @default(autoincrement())
  filename     String
  Avatar       Avatars[]
  date_created DateTime  @default(now())
  date_updated DateTime  @updatedAt
}

model Glasses {
  id           Int       @id @default(autoincrement())
  filename     String
  Avatar       Avatars[]
  date_created DateTime  @default(now())
  date_updated DateTime  @updatedAt
}

model Backgrounds {
  id           Int       @id @default(autoincrement())
  filename     String
  Avatar       Avatars[]
  date_created DateTime  @default(now())
  date_updated DateTime  @updatedAt
}

model Frames {
  id           Int       @id @default(autoincrement())
  filename     String
  Avatar       Avatars[]
  date_created DateTime  @default(now())
  date_updated DateTime  @updatedAt
}

model Users_questlists {
  user_id      Int        @id
  questlist_id Int
  usedBy       Users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  questlist    Questlists @relation(fields: [questlist_id], references: [id])
  date_created DateTime   @default(now())
  date_updated DateTime   @updatedAt
}

model Questlists {
  id               Int                @id @default(autoincrement())
  Users_questlists Users_questlists[]
  quests           Quests[]
  date_created     DateTime           @default(now())
  date_updated     DateTime           @updatedAt
}

model Quests {
  id            Int            @id @default(autoincrement())
  questlist_id  Int
  belongsToList Questlists     @relation(fields: [questlist_id], references: [id])
  quest_details Quest_details?
  date_created  DateTime       @default(now())
  date_updated  DateTime       @updatedAt
}

model Quest_details {
  id           Int      @id
  description  String
  exp          Int
  describes    Quests   @relation(fields: [id], references: [id], onDelete: Cascade)
  date_created DateTime @default(now())
  date_updated DateTime @updatedAt
}

model Friends {
  user1_id     Int
  user2_id     Int
  user1        Users    @relation(name: "is_a_friend", fields: [user1_id], references: [id], onDelete: Cascade)
  user2        Users    @relation(name: "has_a_friend", fields: [user2_id], references: [id], onDelete: Cascade)
  date_created DateTime @default(now())
  date_updated DateTime @updatedAt

  @@id([user1_id, user2_id])
}

model Stats {
  user_id         Int      @id
  coins           Int      @default(0)
  exp             Int      @default(0)
  questsCompleted Int      @default(0)
  user            Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  date_created    DateTime @default(now())
  date_updated    DateTime @updatedAt
}
